--- !u!114 &7427901233783221073
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4469852635701317839}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n<align=\"center\"><size=40><b><color=#FBEF00>TH\xCD NGHI\u1EC6M C\xC1C
    TH\u1EC2 C\u1EE6A CH\u1EA4T V\xC0 \nS\u1EF0 CHUY\u1EC2N TH\u1EC2 C\u1EE6A CH\u1EA4T\n</color></b></size></align>\n<color=#FBEF00><b>1.
    C\xE1c th\u1EC3 c\u1EE7a ch\u1EA5t</b></color>\n\n\u2022 Th\u1EC3 r\u1EAFn (Solid)\nC\xE1c
    ph\xE2n t\u1EED s\u1EAFp x\u1EBFp s\xE1t nhau, li\xEAn k\u1EBFt m\u1EA1nh. C\xF3
    h\xECnh d\u1EA1ng v\xE0 th\u1EC3 t\xEDch c\u1ED1 \u0111\u1ECBnh.\n\n\u2022 Th\u1EC3
    l\u1ECFng (Liquid)\nPh\xE2n t\u1EED g\u1EA7n nhau nh\u01B0ng li\xEAn k\u1EBFt
    y\u1EBFu, c\xF3 th\u1EC3 tr\u01B0\u1EE3t qua nhau. Kh\xF4ng c\xF3 h\xECnh d\u1EA1ng
    c\u1ED1 \u0111\u1ECBnh nh\u01B0ng c\xF3 th\u1EC3 t\xEDch kh\xF4ng \u0111\u1ED5i.\n\n\u2022
    Th\u1EC3 kh\xED (Gas)\nPh\xE2n t\u1EED c\xE1ch xa nhau, chuy\u1EC3n \u0111\u1ED9ng
    nhanh v\xE0 t\u1EF1 do. Kh\xF4ng c\xF3 h\xECnh d\u1EA1ng v\xE0 th\u1EC3 t\xEDch
    c\u1ED1 \u0111\u1ECBnh.\n\n<color=#FBEF00><b>2. S\u1EF1 chuy\u1EC3n th\u1EC3
    c\u1EE7a ch\u1EA5t</b></color>\n\n\u2022 R\u1EAFn -> L\u1ECFng (N\xF3ng ch\u1EA3y)\nCh\u1EA5t
    h\u1EA5p th\u1EE5 nhi\u1EC7t, ph\xE2n t\u1EED dao \u0111\u1ED9ng m\u1EA1nh h\u01A1n.\n\n\u2022
    L\u1ECFng -> Kh\xED (Bay h\u01A1i / S\xF4i)\nT\u0103ng nhi\u1EC7t \u0111\u1ED9
    l\xE0m ph\xE2n t\u1EED tho\xE1t kh\u1ECFi b\u1EC1 m\u1EB7t ch\u1EA5t l\u1ECFng.\n\n\u2022
    Kh\xED -> L\u1ECFng (Ng\u01B0ng t\u1EE5)\nGi\u1EA3m nhi\u1EC7t \u0111\u1ED9,
    ph\xE2n t\u1EED g\u1EA7n nhau v\xE0 t\u1EA1o gi\u1ECDt l\u1ECFng.\n\n\u2022 L\u1ECFng
    -> R\u1EAFn (\u0110\xF4ng \u0111\u1EB7c)\nNhi\u1EC7t \u0111\u1ED9 gi\u1EA3m,
    ph\xE2n t\u1EED li\xEAn k\u1EBFt l\u1EA1i ch\u1EB7t ch\u1EBD.\n\n\u2022 R\u1EAFn
    -> Kh\xED (Th\u0103ng hoa)\nCh\u1EA5t chuy\u1EC3n tr\u1EF1c ti\u1EBFp t\u1EEB
    r\u1EAFn sang kh\xED, kh\xF4ng qua l\u1ECFng.\n\n\u2022 Kh\xED -> R\u1EAFn (Ng\u01B0ng
    k\u1EBFt / K\u1EBFt tinh)\nCh\u1EA5t kh\xED g\u1EB7p l\u1EA1nh v\xE0 \u0111\xF3ng
    th\xE0nh tinh th\u1EC3 r\u1EAFn.\n\n<color=#FBEF00><b>3. Nguy\xEAn nh\xE2n chuy\u1EC3n
    th\u1EC3</b></color>\n\n\u2022 T\u0103ng nhi\u1EC7t -> ph\xE2n t\u1EED chuy\u1EC3n
    \u0111\u1ED9ng m\u1EA1nh h\u01A1n -> r\u1EAFn -> l\u1ECFng -> kh\xED\n\u2022
    Gi\u1EA3m nhi\u1EC7t -> ph\xE2n t\u1EED chuy\u1EC3n \u0111\u1ED9ng ch\u1EADm
    l\u1EA1i -> kh\xED -> l\u1ECFng -> r\u1EAFn\n\n<color=#FBEF00><b>4. Chuy\u1EC3n
    \u0111\u1ED9ng ph\xE2n t\u1EED</b></color>\n\n\u2022 R\u1EAFn: dao \u0111\u1ED9ng
    t\u1EA1i ch\u1ED7, kho\u1EA3ng c\xE1ch r\u1EA5t g\u1EA7n\n\u2022 L\u1ECFng: tr\u01B0\u1EE3t
    qua nhau, kho\u1EA3ng c\xE1ch g\u1EA7n\n\u2022 Kh\xED: chuy\u1EC3n \u0111\u1ED9ng
    nhanh, kho\u1EA3ng c\xE1ch xa"
  m_isRightToLeft: 0
